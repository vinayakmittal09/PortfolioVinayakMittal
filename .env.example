# MongoDB connection string (local or Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/kai-asher-portfolio

# Cloudinary (for image/video uploads via the admin dashboard)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Admin login (used to log into /admin)
ADMIN_EMAIL=vinayakmittal@gmail.com
ADMIN_PASSWORD=Vinayak@123

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Server
PORT=3000
NODE_ENV=development

# Comma separated list of origins allowed to call the API (leave blank to allow same-origin only)
CORS_ORIGIN=
